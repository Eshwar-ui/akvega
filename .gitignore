# Env
.env
.env.*
!.env.example

# Astro build artifacts. `.astro/content.d.ts` and `types.d.ts` stay tracked —
# editors read them for `astro:content` types. These do not: dev.json holds the
# running dev server's PID and port, settings.json a local update-check stamp,
# and the rest is regenerated by `astro sync` on every build.
.astro/dev.json
.astro/settings.json
.astro/collections/
.astro/content-assets.mjs
.astro/content-modules.mjs
