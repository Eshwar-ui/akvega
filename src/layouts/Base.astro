---
import '@/index.css'
import Header from '@/components/layout/Header'
import Footer from '@/components/layout/Footer.astro'
import CustomCursor from '@/components/CustomCursor'
import { organizationSchema, webPageSchema, websiteSchema } from '@/lib/schema'
import { datesFor, normalisePath, type PageDates } from '@/lib/dates'
import { COUNTRY, LOCALE, LOCALITY, REGION_CODE } from '@/lib/site'

/**
 * The one place head metadata is written.
 *
 * The SPA this replaced served a single static index.html for all five routes,
 * so every page shipped the same <title> and — the damaging part — the same
 * `<link rel="canonical" href="https://akvega.com/">`. A canonical is a
 * directive: on /services, /about, /work and /contact it told Google those
 * pages were duplicates of the homepage. Here each page passes its own, and
 * Astro emits it into static HTML that needs no JavaScript to be read.
 */
interface Props {
  title: string
  description: string
  /** Overrides the share image for one page. Defaults to the site card. */
  ogImage?: string
  /**
   * Keep the page out of the index. Used by /work while it has nothing to
   * show: an honest empty state is good for a visitor and a thin page for
   * Google. The page is also filtered from the sitemap in astro.config.mjs.
   */
  noindex?: boolean
  /**
   * Published / modified dates. Looked up in lib/page-dates.json by path
   * unless the page passes its own (pages generated from their own data do).
   * A page with neither fails the build: every page carries a date.
   */
  dates?: PageDates
  /**
   * What the share image shows. Without it a screen reader announces the
   * filename, and a card with no alt is the one image on a shared link.
   */
  ogImageAlt?: string
  /**
   * `article` for a dated post, `website` for everything else. Drives the
   * `article:*` timestamps below, which is what a feed reader, a link
   * unfurler and several AI crawlers read in preference to the JSON-LD.
   */
  ogType?: 'website' | 'article'
  /** Section name for `article:section`. The cluster label, on a post. */
  articleSection?: string
}

const {
  title,
  description,
  ogImage = '/og.png',
  noindex = false,
  ogImageAlt = 'Akvega — growth marketing and digital build, one team.',
  ogType = 'website',
  articleSection,
} = Astro.props

// Search Console / Bing Webmaster ownership tokens. Optional: set in .env as
// PUBLIC_GOOGLE_SITE_VERIFICATION / PUBLIC_BING_SITE_VERIFICATION and the tag
// is emitted; leave unset and nothing is. DNS verification is the better
// long-term route, but the meta tag is the one that works before DNS access.
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION as string | undefined
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION as string | undefined

const robots = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'

// Open Graph wants the underscore form of the BCP 47 tag.
const ogLocale = LOCALE.replace('-', '_')

// Astro.site comes from `site` in astro.config.mjs; Astro.url.pathname is the
// route being built. Together they are the canonical, with no hand-written
// origin to drift out of sync.
//
// The pathname needs normalising first. `build.format: 'file'` emits
// /services.html, and during the build Astro reports that filename as the
// pathname — so a naive canonical came out as https://akvega.com/index.html,
// which is a URL Firebase's `cleanUrls` immediately redirects away from. A
// canonical pointing at a redirect is a canonical Google discards.
const canonicalPath = normalisePath(Astro.url.pathname)

const canonical = new URL(canonicalPath, Astro.site).href
const ogImageUrl = new URL(ogImage, Astro.site).href

const dates = Astro.props.dates ?? datesFor(canonicalPath)
if (!dates) {
  throw new Error(
    `Base: no dates for ${canonicalPath} — add it to src/lib/page-dates.json or pass \`dates\`.`,
  )
}

// Site-wide entity graph plus this page's own node. Page-specific schema
// (BreadcrumbList, FAQPage, the service ItemList) is added by the components
// and pages that own it.
const graph = [
  organizationSchema(),
  websiteSchema(),
  webPageSchema({ url: canonical, name: title, description, dates }),
]
---

<!doctype html>
<html lang={LOCALE}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MH6MH7F6');</script>
    <!-- End Google Tag Manager -->

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-H4KQL6J5NQ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-H4KQL6J5NQ');
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#ffffff" />

    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}

    {/* Geo hints. Weak signals on their own, but they cost nothing and agree
        with the PostalAddress in the Organization JSON-LD below. */}
    <meta name="geo.region" content={`${COUNTRY}-${REGION_CODE}`} />
    <meta name="geo.placename" content={LOCALITY} />

    <!--
      Google renders the SERP favicon inside a circular mask, so the mark is
      inset into icon.svg rather than filling the square: logo.svg is 481x286,
      and a wide mark spanning the full width loses its ends to the crop.
      favicon.ico stays because Google still probes /favicon.ico, and the
      Apple icon must be a PNG — iOS ignores an SVG here and screenshots the
      page instead.
    -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* The font stylesheet is loaded without blocking first paint: fetched as
        a preload, then promoted to a stylesheet once it arrives. Both faces
        use display=swap, so text paints in the fallback stack immediately and
        swaps when Inter lands. Measured on the mobile preset (Lighthouse
        12.8.2, 2026-09-14): the blocking stylesheet cost ~0.85 s of First
        Contentful Paint, and self-hosting the fonts in the critical CSS
        measured worse still (FCP 2.4–2.9 s vs 1.6 s), because the font files
        then compete with the CSS on the critical path. */}
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&family=Instrument+Serif:ital@0;1&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&family=Instrument+Serif:ital@0;1&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Akvega" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    {/* Dated posts only. The timestamps repeat what the BlogPosting JSON-LD
        says, because the crawlers that read one frequently do not read the
        other, and freshness is the signal least worth losing to that. */}
    {
      ogType === 'article' && (
        <>
          <meta property="article:published_time" content={dates.published} />
          <meta property="article:modified_time" content={dates.modified} />
          <meta property="article:publisher" content="https://www.linkedin.com/company/akvega/" />
          {articleSection && <meta property="article:section" content={articleSection} />}
        </>
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {graph.map((node) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(node)} />
    ))}

    <slot name="head" />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MH6MH7F6"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <div class="flex min-h-dvh flex-col">
      <a
        href="#main"
        class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:bg-blue-600 focus:px-4 focus:py-2 focus:text-sm focus:text-white"
      >
        Skip to content
      </a>

      <Header client:load pathname={canonicalPath} />

      <main id="main" class="w-full max-w-full flex-1 overflow-x-hidden">
        <slot />
      </main>

      <Footer />
      <CustomCursor client:idle />
    </div>

    <script>
      import { initReveal } from '@/scripts/reveal'
      import { initAnalytics } from '@/scripts/analytics'

      initReveal()
      initAnalytics()
    </script>
  </body>
</html>
