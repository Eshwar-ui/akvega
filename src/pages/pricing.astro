---
import Base from '@/layouts/Base.astro'
import Breadcrumb from '@/components/Breadcrumb.astro'
import { Icon } from '@/components/Icons'
import LastUpdated from '@/components/LastUpdated.astro'
import {
  GROWTH_CEILING,
  PRICING_PUBLISHED,
  alwaysIncluded,
  buildTiers,
  cadenceLabel,
  diagnostic,
  excluded,
  formatFrom,
  formatInr,
  packages,
  pricingFaqs,
  withGst,
} from '@/lib/pricing'
import { faqSchema } from '@/lib/schema'
import { serviceHref } from '@/lib/services'
import { SITE_URL, site } from '@/lib/site'
import { revealDelayStyle } from '@/scripts/reveal'

/**
 * Pricing. Nobody else in the Hyderabad agency market publishes numbers, so
 * this page is a differentiator on its own — but only if the numbers are
 * real. Every figure comes from lib/pricing.ts. Growth marketing is three
 * monthly packages with confirmed prices; build work shows "Quoted from the
 * diagnostic" until a starting price is confirmed.
 *
 * Layout: the diagnostic first, because it is the door; the three growth
 * packages with GST and the client's own ad budget stated beside each; Build
 * as project prices; what is always included, what never is; and a FAQ that
 * answers the question a buyer has before they email — "how much does it
 * actually cost?" — in a sentence an answer engine can quote.
 */
const TITLE = 'Digital Marketing Pricing — from ₹20,000/month | Akvega'
const DESCRIPTION =
  'Akvega packages: Local Visibility ₹20,000, Search & Social Growth ₹40,000, Market Leader ₹60,000/month + GST. Websites and apps quoted from a diagnostic.'

const PAGE_URL = `${SITE_URL}/pricing`
const FALLBACK_PRICE = 'Quoted from the diagnostic'

const cheapest = packages[0]
const dearest = packages[packages.length - 1]

---

<Base title={TITLE} description={DESCRIPTION} noindex={!PRICING_PUBLISHED}>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema(pricingFaqs, PAGE_URL))} />

  <div class="px-3 pt-3 sm:px-5 sm:pt-5">
    <div
      class="hero-field edge-light relative isolate overflow-hidden rounded-xl border border-hairline sm:rounded-2xl"
    >
      <div class="mx-auto max-w-site px-5 py-16 sm:px-8 sm:py-24">
        <Breadcrumb current="Pricing" />
        <p class="type-overline mt-7 text-ink-muted">Pricing</p>
        <h1 class="type-page-title mt-3 max-w-[18ch] text-balance">
          How much does digital marketing cost at Akvega?
        </h1>
        <p class="type-body mt-5 max-w-[54ch] text-ink-muted">
          Three growth marketing packages from {formatInr(cheapest.monthly)} to {formatInr(dearest.monthly)} a
          month plus GST, custom scopes to {formatInr(GROWTH_CEILING)}, and build work quoted from a paid
          diagnostic. No discovery call whose only purpose is to find out your budget.
        </p>
        <LastUpdated class="mt-6" />
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-site px-5 pt-16 sm:px-8 sm:pt-20">
  </div>

  {/* The diagnostic. One card, on its own, because it is the door every
      engagement walks through and the thing that turns a build range into a
      fixed number for your scope. */}
  <section data-reveal-root data-shown="false" class="mx-auto max-w-site px-5 py-16 sm:px-8 sm:py-24">
    <div
      class="reveal edge-light-dark grid gap-10 overflow-hidden rounded-2xl bg-navy px-6 py-10 sm:px-10 sm:py-14 lg:grid-cols-[1.1fr_1fr] lg:gap-16 lg:px-14"
    >
      <div>
        <p class="type-overline text-blue-200">Step one, always</p>
        <h2 class="type-section-title mt-4 text-balance text-white">{diagnostic.name}</h2>
        <p class="type-body mt-5 max-w-[46ch] text-blue-200">{diagnostic.summary}</p>

        <div class="mt-8 flex flex-wrap items-baseline gap-x-3 gap-y-1">
          {
            formatFrom(diagnostic.from) ? (
              <>
                <span class="text-[clamp(2.25rem,5vw,3.25rem)] font-semibold leading-none tracking-[-0.02em] text-white">
                  {formatFrom(diagnostic.from)}
                </span>
                <span class="text-[15px] text-blue-200">{cadenceLabel(diagnostic.cadence)}, excl. GST</span>
              </>
            ) : (
              <span class="text-[clamp(1.5rem,3vw,2rem)] font-semibold leading-tight tracking-[-0.02em] text-white">
                Fixed fee, agreed before we start
              </span>
            )
          }
        </div>
        <p class="mt-2 text-[14px] text-blue-200">Handed over within {diagnostic.duration} of kickoff.</p>

        <p class="type-overline mt-8 text-[11px] text-blue-300">What we audit</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            diagnostic.audits.map((item) => (
              <li class="rounded-full border border-white/15 px-3.5 py-1.5 text-[13px] text-blue-100">{item}</li>
            ))
          }
        </ul>

        <a
          href={site.primaryCta.to}
          data-cta="pricing-diagnostic"
          class="press mt-8 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3.5 text-[15px] font-medium text-navy"
        >
          Book a diagnostic
          <Icon name="arrowUpRight" className="size-4" />
        </a>
      </div>

      <ul class="space-y-4 self-center border-t border-white/10 pt-8 lg:border-l lg:border-t-0 lg:pl-12 lg:pt-0">
        {
          diagnostic.includes.map((item, i) => (
            <li style={revealDelayStyle(i + 1, 70)} class="reveal flex items-start gap-3 text-[16px] text-blue-100">
              <Icon name="check" className="mt-1 size-4 shrink-0 text-energy" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Growth packages. Three cards, the middle one featured, each showing the
      fee, the GST-inclusive total and the client's own ad budget — the three
      numbers a buyer needs to compare us with anyone else. */}
  <section
    id="packages"
    data-reveal-root
    data-shown="false"
    class="mx-auto max-w-site scroll-mt-28 px-5 pb-20 sm:px-8 sm:pb-28"
  >
    <div class="reveal flex flex-col gap-6 border-t border-ink/12 pt-8 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
      <h2 class="type-track-title text-signal">Growth</h2>
      <p class="type-body max-w-[46ch] text-ink-muted lg:text-right">
        Monthly packages with a defined scope. Ad spend stays in your own accounts and is stated
        beside each package so the full monthly cost is on the page.
      </p>
    </div>

    <ul class="mt-10 grid gap-4 lg:grid-cols-3 lg:gap-5">
      {
        packages.map((pkg, i) => (
          <li
            id={`package-${pkg.slug}`}
            style={revealDelayStyle(i + 1, 90)}
            class={`reveal relative flex scroll-mt-28 flex-col rounded-2xl border p-6 sm:p-8 ${
              pkg.featured
                ? 'edge-light-dark border-navy bg-navy text-white'
                : 'border-hairline bg-paper text-ink'
            }`}
          >
            {pkg.featured ? (
              <span class="absolute right-6 top-6 rounded-full bg-energy px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.08em] text-navy">
                Most chosen
              </span>
            ) : null}

            <p class={`type-overline text-[11px] ${pkg.featured ? 'text-blue-300' : 'text-ink-muted'}`}>
              Package {String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="type-card-title mt-3">{pkg.name}</h3>
            <p class={`mt-3 text-[14px] leading-relaxed ${pkg.featured ? 'text-blue-200' : 'text-ink-muted'}`}>
              {pkg.audience}
            </p>

            <div class="mt-6">
              <p class="flex flex-wrap items-baseline gap-x-2">
                <span class="text-[clamp(2rem,4vw,2.75rem)] font-semibold leading-none tracking-[-0.02em]">
                  {formatInr(pkg.monthly)}
                </span>
                <span class={`text-[14px] ${pkg.featured ? 'text-blue-200' : 'text-ink-muted'}`}>/ month</span>
              </p>
              <p class={`mt-2 text-[13px] ${pkg.featured ? 'text-blue-200' : 'text-ink-muted'}`}>
                + 18% GST · {formatInr(withGst(pkg.monthly))} a month all in
              </p>
            </div>

            <ul class={`mt-7 flex-1 space-y-2.5 border-t pt-6 ${pkg.featured ? 'border-white/10' : 'border-hairline'}`}>
              {pkg.includes.map((item) => (
                <li class="flex items-start gap-2.5 text-[15px] leading-snug">
                  <Icon
                    name="check"
                    className={`mt-0.5 size-4 shrink-0 ${pkg.featured ? 'text-energy' : 'text-signal'}`}
                  />
                  {item}
                </li>
              ))}
            </ul>

            <p class={`mt-6 text-[13px] ${pkg.featured ? 'text-blue-200' : 'text-ink-muted'}`}>
              Your ad budget: {formatInr(pkg.adBudget.min)} to {formatInr(pkg.adBudget.max)} a month, paid to the
              platforms directly.
            </p>

            <a
              href={site.primaryCta.to}
              data-cta={`pricing-package-${pkg.slug}`}
              class={`press mt-6 inline-flex items-center justify-center gap-2 rounded-full px-6 py-3.5 text-[15px] font-medium ${
                pkg.featured ? 'bg-white text-navy' : 'bg-navy text-white'
              }`}
            >
              Start with {pkg.name}
              <Icon name="arrowUpRight" className="size-4" />
            </a>
          </li>
        ))
      }
    </ul>

    <p class="reveal type-body mt-8 max-w-[62ch] text-ink-muted" style={revealDelayStyle(4)}>
      Need more than the largest package — more markets, more languages, more platforms? Custom scopes
      run up to {formatInr(GROWTH_CEILING)} a month and are quoted from the diagnostic.
    </p>
  </section>

  {/* Build. Per project, from the diagnostic. */}
  <section data-reveal-root data-shown="false" class="mx-auto max-w-site px-5 pb-24 sm:px-8 sm:pb-32">
    <div class="reveal flex flex-col gap-6 border-t border-ink/12 pt-8 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
      <h2 class="type-track-title text-vega">Build</h2>
      <p class="type-body max-w-[46ch] text-ink-muted lg:text-right">
        Priced per project from the diagnostic, with the number fixed before the first line of code.
      </p>
    </div>

    <ul class="mt-4">
      {
        buildTiers.map((tier, i) => {
          const price = formatFrom(tier.from)
          return (
            <li
              id={`pricing-${tier.slug}`}
              style={revealDelayStyle(i + 1, 80)}
              class="reveal grid scroll-mt-28 gap-6 border-t border-hairline py-10 sm:py-12 lg:grid-cols-[1fr_1.4fr] lg:gap-16"
            >
              <div>
                <h3 class="type-card-title">
                  <a href={serviceHref(tier)} class="link-sweep">
                    {tier.name}
                  </a>
                </h3>
                <p class="type-body mt-3 max-w-[40ch] text-ink-muted">{tier.summary}</p>

                <div class="mt-6">
                  {price ? (
                    <p class="flex flex-wrap items-baseline gap-x-2">
                      <span class="text-[13px] text-ink-muted">from</span>
                      <span class="text-[clamp(1.75rem,3.5vw,2.5rem)] font-semibold leading-none tracking-[-0.02em] text-ink">
                        {price}
                      </span>
                      <span class="text-[14px] text-ink-muted">{cadenceLabel(tier.cadence)}</span>
                    </p>
                  ) : (
                    <p class="inline-flex items-center gap-2 rounded-full border border-hairline bg-paper px-4 py-2 text-[14px] font-medium text-ink">
                      <Icon name="target" className="size-4 text-vega" />
                      {FALLBACK_PRICE}
                    </p>
                  )}
                </div>
              </div>

              <div class="grid gap-8 sm:grid-cols-2">
                <div>
                  <p class="type-overline text-[11px] text-ink-muted">Included from the start</p>
                  <ul class="mt-4 space-y-2.5">
                    {tier.includes.map((item) => (
                      <li class="flex items-start gap-2.5 text-[15px] leading-snug text-ink">
                        <Icon name="check" className="mt-0.5 size-4 shrink-0 text-vega" />
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <p class="type-overline text-[11px] text-ink-muted">What moves the number</p>
                  <ul class="mt-4 space-y-2.5">
                    {tier.scales.map((item) => (
                      <li class="flex items-start gap-2.5 text-[15px] leading-snug text-ink-muted">
                        <Icon name="trend" className="mt-0.5 size-4 shrink-0 text-ink-muted/60" />
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </li>
          )
        })
      }
    </ul>
  </section>

  {/* Always / never. The engagement model, stated once, next to the costs
      the fees deliberately leave out. */}
  <section data-reveal-root data-shown="false" class="px-3 sm:px-5">
    <div class="mx-auto grid max-w-site gap-4 lg:grid-cols-[1.5fr_1fr]">
      <div class="rounded-2xl border border-hairline bg-surface/60 p-6 sm:p-10">
        <p class="reveal type-overline text-ink-muted">In every engagement</p>
        <ul class="mt-6 grid gap-8 sm:grid-cols-2">
          {
            alwaysIncluded.map((item, i) => (
              <li style={revealDelayStyle(i + 1, 70)} class="reveal">
                <h3 class="text-[17px] font-medium leading-snug text-ink">{item.title}</h3>
                <p class="type-body mt-2 text-ink-muted">{item.body}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rounded-2xl border border-hairline bg-paper p-6 sm:p-10">
        <p class="reveal type-overline text-ink-muted">Not in the fee</p>
        <ul class="mt-6 space-y-4">
          {
            excluded.map((item, i) => (
              <li style={revealDelayStyle(i + 1, 70)} class="reveal flex items-start gap-3 text-[15px] leading-snug text-ink">
                <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-ink/30"></span>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* FAQ. Rendered from `pricingFaqs`, the same array the FAQPage JSON-LD in
      the head serialises. */}
  <section data-reveal-root data-shown="false" class="mx-auto max-w-site px-5 py-24 sm:px-8 sm:py-32">
    <div class="grid gap-12 lg:grid-cols-[300px_1fr] lg:gap-16">
      <h2 class="reveal type-section-title max-w-[12ch] lg:sticky lg:top-28 lg:self-start">
        Questions about the numbers.
      </h2>

      <div>
        {
          pricingFaqs.map((item, i) => (
            <details
              id={`faq-${item.slug}`}
              name="pricing-faq"
              style={revealDelayStyle(i, 60)}
              class="reveal group scroll-mt-28 border-b border-hairline first:border-t"
            >
              <summary class="flex cursor-pointer list-none items-start justify-between gap-8 py-7 text-left sm:py-8 [&::-webkit-details-marker]:hidden">
                <span class="flex items-baseline gap-4 sm:gap-5">
                  <span class="type-overline shrink-0 tabular-nums text-[11px] text-ink-muted/45 sm:text-xs">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="text-xl font-medium leading-[1.25] transition-colors duration-300 ease-out-expo group-hover:text-signal sm:text-2xl">
                    {item.q}
                  </span>
                </span>
                <span class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-full border border-hairline text-ink-muted transition-transform duration-300 ease-out-expo group-open:rotate-45">
                  <Icon name="plus" className="size-4" />
                </span>
              </summary>
              <p class="type-body max-w-[62ch] pb-8 pl-9 text-ink-muted sm:pl-12">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="px-3 pb-6 sm:px-5 sm:pb-8">
    <div
      data-reveal-root
      data-shown="false"
      class="edge-light-dark mx-auto max-w-site overflow-hidden rounded-xl bg-navy px-5 py-16 text-center sm:rounded-2xl sm:px-8 sm:py-24"
    >
      <h2 class="reveal type-section-title mx-auto max-w-[18ch] text-balance text-white">
        Send the problem. We’ll send the number.
      </h2>
      <p style={revealDelayStyle(1)} class="reveal type-lede mx-auto mt-5 max-w-[46ch] text-blue-200">
        A diagnostic returns within {diagnostic.duration} with every finding priced.
      </p>
      <div style={revealDelayStyle(2)} class="reveal mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
        <a
          href={site.primaryCta.to}
          data-cta="pricing-start-project"
          class="press type-ui rounded-full bg-white px-7 py-3.5 text-navy"
        >
          {site.primaryCta.label}
        </a>
        <a
          href={`mailto:${site.email}`}
          class="press type-ui rounded-full border border-white/20 px-7 py-3.5 text-white hover:border-white/50"
        >
          {site.email}
        </a>
      </div>
    </div>
  </section>
</Base>
