---
import Base from '@/layouts/Base.astro'
import Hero from '@/components/hero/Hero'
import Capabilities from '@/components/sections/Capabilities'
import Services from '@/components/sections/Services'
import TechStackShowcase from '@/components/sections/TechStackShowcase'
import Approach from '@/components/sections/Approach'
import Assurance from '@/components/sections/Assurance'
import Process from '@/components/sections/Process'
import Faq from '@/components/sections/Faq'
import CallToAction from '@/components/sections/CallToAction'
import KeyFacts from '@/components/KeyFacts.astro'
import ReviewedBy from '@/components/ReviewedBy.astro'
import { faqSchema } from '@/lib/schema'
import { SITE_URL } from '@/lib/site'

/**
 * Only three sections hydrate. Hero drives a GSAP timeline and needs to be
 * running before the fold is read, so it loads eagerly; Capabilities holds tab
 * state and Services runs a GSAP Flip reflow, both of which can wait until the
 * reader reaches them.
 *
 * Everything else renders to static HTML with no client directive at all — the
 * entrance animations they used to need React for now come from
 * `data-reveal-root` plus the ~30-line observer in scripts/reveal.ts.
 */
const keyFacts = [
  'Akvega is a growth marketing and digital build team based in Hyderabad, India, founded by Kalyan Kumar Bedugam.',
  'Akvega runs SEO, Google Ads, Meta Ads and social media alongside websites, online stores, mobile apps and custom tools.',
  'At Akvega, the campaign and the product it points to are shipped by the same people.',
  'Every Akvega engagement starts with a paid diagnostic returned within 1 to 2 working days.',
  'Akvega sets up repositories, ad accounts and analytics in the client’s name from day one.',
  'Akvega digital marketing packages start at ₹20,000 a month plus GST.',
]
---

<Base
  title="Akvega — Growth marketing and digital build, one team | Hyderabad"
  description="Akvega is a Hyderabad growth and engineering team — search, ads and social alongside websites, apps and custom systems, shipped by the same people."
>
  {/* The FAQ section renders `faqs` from lib/services.ts verbatim, so this
      markup and the visible answers are the same strings by construction. */}
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema(undefined, `${SITE_URL}/`))} />

  <Hero client:load />

  {/* The extraction block. Static, directly under the hero, so the first
      thing after the H1 in the HTML is six checkable sentences an answer
      engine can quote. See AEO.md. */}
  <div class="mx-auto grid max-w-site gap-10 px-5 pb-8 pt-4 sm:px-8 lg:grid-cols-[1fr_320px] lg:gap-16">
    <KeyFacts facts={keyFacts} class="max-w-[64ch]" />
    <ReviewedBy class="lg:self-end" />
  </div>

  <Capabilities client:visible />
  <Services client:visible />
  <TechStackShowcase />
  <Approach />
  <Assurance />
  <Process />
  <Faq />
  <CallToAction />
</Base>
