---
import Base from '@/layouts/Base.astro'
import Breadcrumb from '@/components/Breadcrumb.astro'
import { Icon, type IconName } from '@/components/Icons'
import TechStack from '@/components/TechStack'
import { serviceCount, tracks } from '@/lib/services'
import { revealDelayStyle } from '@/scripts/reveal'
import { servicesSchema } from '@/lib/schema'

/**
 * The definitive services reference — everything lib/services.ts knows, with a
 * real anchor per slug (#search, #websites, …) so the homepage's capability
 * shelf, the footer directory and any shared link land on the actual service
 * rather than the page top.
 *
 * Entirely static: no island on this page at all. It is the page most likely to
 * earn search traffic for a service term, and now every word of it is in the
 * HTML before a single byte of JavaScript runs.
 */
const serviceIcons: Record<string, IconName> = {
  search: 'search',
  'paid-search': 'target',
  'paid-social': 'spark',
  social: 'chat',
  branding: 'brand',
  websites: 'browser',
  commerce: 'bag',
  mobile: 'mobile',
  design: 'layers',
  custom: 'sliders',
}
---

<Base
  title="Services — SEO, ads, websites and apps | Akvega"
  description="Ten services across two tracks: SEO, Google Ads, Meta Ads, social and branding, plus websites, online stores, mobile apps, product design and custom tools."
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(servicesSchema())}
  />

  {/* Banner — same .hero-field panel Contact's banner established, so a visitor
      landing here directly still recognises the hero's material. */}
  <div class="px-3 pt-3 sm:px-5 sm:pt-5">
    <div
      class="hero-field edge-light relative isolate overflow-hidden rounded-xl border border-hairline sm:rounded-2xl"
    >
      <div class="mx-auto max-w-site px-5 py-16 sm:px-8 sm:py-24">
        <Breadcrumb current="Services" />
        <p class="type-overline mt-7 text-ink-muted">What we run</p>
        <h1 class="type-page-title mt-3 max-w-[20ch]">Everything we do, in one place.</h1>
        <p class="type-body mt-5 max-w-[52ch] text-ink-muted">
          {serviceCount} services across two tracks. Hire one, or hire both — most clients end
          up wanting both.
        </p>
      </div>
    </div>
  </div>

  <section class="mx-auto max-w-site px-5 py-20 sm:px-8 sm:py-28">
    {
      tracks.map((track, trackIndex) => {
        const accentText = track.accent === 'signal' ? 'text-signal' : 'text-vega'
        return (
          <div
            data-reveal-root
            data-shown="false"
            class={trackIndex === 0 ? '' : 'mt-24 sm:mt-32'}
          >
            <div class="reveal flex flex-col gap-6 border-t border-ink/12 pt-8 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
              <div class="flex items-baseline gap-5">
                <h2 class={`type-track-title ${accentText}`}>{track.label}</h2>
                <span class="text-sm tabular-nums text-ink-muted">
                  {String(track.services.length).padStart(2, '0')}
                </span>
              </div>
              <p class="type-body max-w-[46ch] text-ink-muted lg:text-right">{track.statement}</p>
            </div>

            <ul class="mt-4">
              {track.services.map((service, i) => (
                <li
                  id={service.slug}
                  style={revealDelayStyle(i + 1, 80)}
                  class="reveal grid scroll-mt-28 gap-4 border-t border-hairline py-9 sm:py-11 lg:grid-cols-[1fr_1.35fr] lg:gap-16"
                >
                  <div class="flex items-start gap-4">
                    <Icon
                      name={serviceIcons[service.slug]}
                      className={`mt-1.5 size-6 shrink-0 sm:mt-2 ${accentText}`}
                    />
                    <h3 class="type-card-title">{service.name}</h3>
                  </div>

                  <div>
                    <p class="type-body max-w-[60ch] text-ink-muted">{service.blurb}</p>
                    <p class="type-overline mt-5 text-[11px] text-ink-muted">
                      {service.deliverables.join(' · ')}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        )
      })
    }
  </section>

  <section id="stack" class="mx-auto max-w-site scroll-mt-24 px-5 pb-24 sm:px-8 sm:pb-32">
    <p class="type-overline text-ink-muted">What we build with</p>
    <h2 class="type-section-title mt-5 max-w-[16ch] text-balance">
      Key technologies, chosen deliberately.
    </h2>
    <p class="type-body mt-5 max-w-[52ch] text-ink-muted">
      The smallest proven combination for the product — not the longest list of logos we can fit
      on a page.
    </p>
    {/* Placeholder set — confirm every mark below is a tool Akvega actually
        uses before this page goes live (see DESIGN.md). */}
    <div class="mt-14">
      <TechStack />
    </div>
  </section>
</Base>
