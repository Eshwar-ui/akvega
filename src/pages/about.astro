---
import Base from '@/layouts/Base.astro'
import Breadcrumb from '@/components/Breadcrumb.astro'
import { Icon, type IconName } from '@/components/Icons'
import { process } from '@/lib/services'
import { revealDelayStyle } from '@/scripts/reveal'

/**
 * "Studio" in the nav, /about in the URL — no real team roster, photos or
 * founding story are confirmed, so this page is built entirely from what
 * PRODUCT.md and the brand guidelines already establish as fact: the
 * Growth/Build positioning, the operating model, and the six personality traits
 * from guideline 01. No invented people, no invented history — see DESIGN.md's
 * placeholder inventory before adding a team section here.
 */
const traits = [
  {
    trait: 'Modern',
    not: 'not futuristic',
    body: "We build with what's proven, not what's trending. No AI theatre, no interface trick a client can't maintain after we leave.",
  },
  {
    trait: 'Confident',
    not: 'not loud',
    body: 'The work should read as sure of itself without needing to shout to prove it.',
  },
  {
    trait: 'Technical',
    not: 'not complicated',
    body: 'Real engineering underneath, explained in plain language on top.',
  },
  {
    trait: 'Direct',
    not: 'not abrupt',
    body: "We'll tell you what isn't working. We won't be rude about it.",
  },
  {
    trait: 'Premium',
    not: 'not ornamental',
    body: 'Quality shows up in the details that hold up under use, not the ones that just look good in a deck.',
  },
  {
    trait: 'Adaptive',
    not: 'not inconsistent',
    body: 'The system flexes per engagement. The standard behind it does not.',
  },
]

const fit: { title: string; body: string; icon: IconName }[] = [
  {
    title: 'Lead the engagement',
    body: 'We run it end to end — strategy, delivery and the team behind both.',
    icon: 'target',
  },
  {
    title: 'Embed with yours',
    body: 'Your team sets direction; ours ships inside it, on your tools and cadence.',
    icon: 'layers',
  },
  {
    title: 'Sit behind it as the bench',
    body: 'Your team stays visible to the client or stakeholders; we do the engineering and media work behind them.',
    icon: 'sliders',
  },
]
---

<Base
  title="Studio — one team for growth and build | Akvega"
  description="How Akvega works: two tracks under one roof, a paid diagnostic before any commitment, and engagements we lead, embed in, or sit behind as your bench."
>
  <div class="px-3 pt-3 sm:px-5 sm:pt-5">
    <div
      class="hero-field edge-light relative isolate overflow-hidden rounded-xl border border-hairline sm:rounded-2xl"
    >
      <div class="mx-auto max-w-site px-5 py-16 sm:px-8 sm:py-24">
        <Breadcrumb current="Studio" />
        <p class="type-overline mt-7 text-ink-muted">Studio</p>
        <h1 class="type-page-title mt-3 max-w-[18ch]">One team, built to hold both ends.</h1>
        <p class="type-body mt-5 max-w-[52ch] text-ink-muted">
          Akvega runs growth marketing and digital build under one roof — not because it's a
          trend, but because the handoff between two vendors is where most of the work actually
          breaks.
        </p>
      </div>
    </div>
  </div>

  {/* Values — the six personality traits from the brand guidelines (01), stated
      as contrast pairs rather than a generic adjective list, since that's the
      actual documented shape of the brief. */}
  <section
    data-reveal-root
    data-shown="false"
    class="mx-auto max-w-site px-5 py-20 sm:px-8 sm:py-28"
  >
    <p class="reveal type-overline text-ink-muted">How we hold the line</p>
    <h2
      style={revealDelayStyle(1)}
      class="reveal type-section-title mt-5 max-w-[20ch] text-balance"
    >
      Six traits, held as pairs — one to reach for, one to reject.
    </h2>

    <ul class="mt-14 grid gap-x-10 gap-y-10 sm:mt-16 sm:grid-cols-2 lg:grid-cols-3">
      {
        traits.map((item, i) => (
          <li style={revealDelayStyle(i + 2, 70)} class="reveal border-t border-hairline pt-6">
            <p class="flex flex-wrap items-baseline gap-x-2.5">
              <span class="type-card-title">{item.trait}</span>
              <span class="text-sm text-ink-muted">{item.not}</span>
            </p>
            <p class="type-body mt-3 text-ink-muted">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {/* How we work — the same four stages Process carries on the homepage, in a
      plainer form here: the drawn-line spine is that section's own device, not
      one to spread onto a second page. */}
  <section data-reveal-root data-shown="false" class="px-3 sm:px-5">
    <div
      class="edge-light-dark mx-auto max-w-site overflow-hidden rounded-xl bg-navy px-5 py-20 sm:rounded-2xl sm:px-12 sm:py-28 lg:px-16"
    >
      <p class="reveal type-overline text-blue-300">How we work</p>
      <h2
        style={revealDelayStyle(1)}
        class="reveal type-section-title mt-5 max-w-[16ch] text-balance text-white"
      >
        Four stages, in this order.
      </h2>

      <ol class="mt-14 grid gap-10 sm:mt-16 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        {
          process.map((step, i) => (
            <li style={revealDelayStyle(i + 2, 80)} class="reveal border-t border-white/15 pt-6">
              <span class="text-sm tabular-nums text-blue-300/70">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-2 text-lg font-medium text-white">{step.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-blue-200">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* Where we fit — the engagement-model flexibility PRODUCT.md confirms,
      distinct from Assurance's ownership/diagnostic facts on the homepage so the
      two pages complement rather than repeat. */}
  <section
    data-reveal-root
    data-shown="false"
    class="mx-auto max-w-site px-5 py-20 sm:px-8 sm:py-28"
  >
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div class="reveal lg:sticky lg:top-28 lg:self-start">
        <p class="type-overline text-ink-muted">Where we fit</p>
        <h2
          style={revealDelayStyle(1)}
          class="reveal type-section-title mt-5 max-w-[16ch] text-balance"
        >
          Ahead of your team, inside it, or behind it.
        </h2>
        <p style={revealDelayStyle(2)} class="reveal type-body mt-5 max-w-[38ch] text-ink-muted">
          Whichever shape fits, the diagnostic comes first — you get the findings whether or not
          you continue with us.
        </p>
        <a
          href="/contact"
          style={revealDelayStyle(3)}
          class="press reveal type-ui mt-8 inline-flex items-center gap-2 rounded-full bg-navy px-7 py-3.5 text-white"
        >
          Start a conversation
        </a>
      </div>

      <ul class="flex flex-col gap-10 sm:gap-11">
        {
          fit.map((item, i) => (
            <li
              style={revealDelayStyle(i + 2, 80)}
              class="reveal border-l-2 border-signal py-0.5 pl-6"
            >
              <div class="flex items-center gap-3">
                <Icon name={item.icon} className="size-5 shrink-0 text-signal" />
                <h3 class="text-lg font-semibold text-ink">{item.title}</h3>
              </div>
              <p class="type-body mt-2.5 text-ink-muted">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
