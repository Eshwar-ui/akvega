---
import Base from '@/layouts/Base.astro'
import { datesFor } from '@/lib/dates'

/**
 * Firebase Hosting serves this automatically for unmatched paths, and — unlike
 * the SPA's catch-all route, which returned HTTP 200 with the app shell — it
 * serves it with a real 404 status. Those soft 404s were being logged by Google
 * as low-quality pages.
 *
 * In dev this page also answers any unknown path (favicon.ico included), so
 * its dates are passed explicitly rather than looked up by the request path.
 */
---

<Base
  title="Page not found | Akvega"
  description="That page doesn't exist. The link may be out of date, or the page has moved."
  noindex
  dates={datesFor('/404')}
>
  <div class="mx-auto flex max-w-site flex-col items-start px-5 py-32 sm:px-8">
    <h1 class="type-page-title">That page doesn’t exist.</h1>
    <p class="type-body mt-4 text-ink-muted">
      The link may be out of date, or the page has moved.
    </p>
    <a
      href="/"
      class="type-ui mt-8 rounded-md bg-blue-600 px-6 py-3 text-white transition-colors duration-200 hover:bg-blue-700"
    >
      Back home
    </a>
  </div>
</Base>
