---
/**
 * The visible breadcrumb, plus its BreadcrumbList JSON-LD.
 *
 * Both come from one component on purpose: the markup and the structured data
 * are two statements about the same trail, and Google penalises them disagreeing
 * far more readily than it rewards either alone. Keeping them in one file makes
 * it impossible to update one and forget the other.
 */
interface Props {
  current: string
  /** An intermediate level, e.g. Services above a service page. */
  parent?: { label: string; href: string }
}

const { current, parent } = Astro.props

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/index$/, '')
const url = new URL(path || '/', Astro.site).href
const home = new URL('/', Astro.site).href

const trail = [
  { name: 'Home', item: home },
  ...(parent ? [{ name: parent.label, item: new URL(parent.href, Astro.site).href }] : []),
  { name: current, item: url },
]

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.name,
    item: crumb.item,
  })),
}
---

<nav aria-label="Breadcrumb" class="flex items-center gap-2 text-[13px]">
  <a href="/" class="link-sweep text-ink-muted hover:text-ink">Home</a>
  <span aria-hidden="true" class="text-ink-muted">/</span>
  {
    parent ? (
      <>
        <a href={parent.href} class="link-sweep text-ink-muted hover:text-ink">{parent.label}</a>
        <span aria-hidden="true" class="text-ink-muted">/</span>
      </>
    ) : null
  }
  <span class="font-medium text-ink">{current}</span>
</nav>

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(breadcrumbLd)}
/>
