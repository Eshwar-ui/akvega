---
import { type PageDates } from '@/lib/dates'
import { FOUNDER, site } from '@/lib/site'

/**
 * The attribution line: AEO.md §3 principle 3, in one sentence.
 *
 * Order is name → credentials → organisation, deliberately. Leading with the
 * company shadows the person, and the person is the part that carries
 * expertise — an agency page with no named human has nothing to weigh.
 *
 * The visible line and the `Person` node in lib/schema.ts read the same
 * values from `FOUNDER` in lib/site.ts, so what a reader sees and what a
 * crawler parses cannot disagree.
 */
interface Props {
  dates: PageDates
  /** "Written and reviewed by" on a post; "Reviewed by" on a standing page. */
  verb?: string
  class?: string
}

const { dates, verb = 'Written and reviewed by', class: className = '' } = Astro.props

const reviewed = new Date(`${dates.modified}T00:00:00Z`)
const humanDate = reviewed.toLocaleDateString('en-IN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
})
---

<p class={`meta text-[13px] leading-relaxed text-ink-muted ${className}`}>
  {verb}{' '}
  <span class="font-medium text-ink">{FOUNDER.name}</span>, {FOUNDER.credentials}, {FOUNDER.jobTitle} at
  {' '}{site.name} — <time datetime={dates.modified}>{humanDate}</time>
</p>
