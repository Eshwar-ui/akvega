---
import { datesFor, type PageDates } from '@/lib/dates'
import { FOUNDER_CREDENTIALS, FOUNDER_NAME, FOUNDER_TITLE, site } from '@/lib/site'

/**
 * The attribution line. One clean sentence — name, role, organisation, date —
 * because answer engines credit an individual only when the individual is
 * named in the same breath as the claim; otherwise the organisation absorbs
 * the credit and the person is invisible (the "institution shadow" finding).
 *
 * The date is the same value the layout emits as `dateModified`, so the
 * human-readable and machine-readable freshness signals agree.
 */
interface Props {
  /** Pass when the page's dates live on its own data rather than in page-dates.json. */
  dates?: PageDates
  class?: string
}

const { dates = datesFor(Astro.url.pathname), class: className = '' } = Astro.props

if (!dates) {
  throw new Error(`ReviewedBy: no dates for ${Astro.url.pathname} — add it to src/lib/page-dates.json`)
}

const modified = new Date(`${dates.modified}T00:00:00Z`)
const humanDate = modified.toLocaleDateString('en-IN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
})
---

<div class={`meta text-[13px] leading-relaxed text-ink-muted ${className}`}>
  <p>
    Reviewed by <span class="font-medium text-ink">{FOUNDER_NAME}</span>, {FOUNDER_TITLE}, {site.name} — {FOUNDER_CREDENTIALS}.
  </p>
  <p class="mt-0.5">
    Last updated <time datetime={dates.modified}>{humanDate}</time>
  </p>
</div>
