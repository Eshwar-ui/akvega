# Firebase web app config. Copy to `.env` and fill from the Firebase console
#
# These are public identifiers — the SDK ships every one of them to the browser
# by design. They live here rather than in source so a different Firebase
# project can be pointed at without touching code. Real secrets never belong
# behind a VITE_ prefix: Vite inlines those into the bundle.
#
# No measurement ID: GA4 is tagged directly in src/layouts/Base.astro
# (GTM + gtag).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
