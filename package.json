{
  "name": "akvega",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch --env-file=functions/.env functions/dev-server.js",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --force",
    "preview": "vite preview",
    "icons": "node scripts/build-tech-icons.mjs",
    "images": "node scripts/optimize-images.mjs",
    "deploy": "npm run build && firebase deploy --only hosting,functions:contact --project akvegadigital",
    "test:contact": "npm --prefix functions test",
    "deploy:preview": "npm run build && firebase hosting:channel:deploy preview --expires 7d --project akvegadigital"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^12.18.0",
    "gsap": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "simple-icons": "^16.29.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
